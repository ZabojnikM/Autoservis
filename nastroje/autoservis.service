# Šablona služby systemd pro Autoservis na Linuxu.
# Doplň User a cestu (WorkingDirectory, ExecStart), pak:
#   sudo cp autoservis.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now autoservis
[Unit]
Description=Autoservis (FastAPI)
After=network.target

[Service]
User=UZIVATEL
WorkingDirectory=/CESTA/K/AUTOSERVIS
ExecStart=/CESTA/K/AUTOSERVIS/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
EnvironmentFile=-/CESTA/K/AUTOSERVIS/.env
# Aktualizace tlačítkem v Nastavení (jen když složka je git klon):
#   vydani = jen vydané verze vX.Y.Z (výchozí, ostrý provoz), main = každý commit (jen pro zkoušení)
Environment=AUTOSERVIS_AKTUALIZACE=vydani
# Záložka Příjem vozidel (#51): JSON s návštěvami z OpenBotu (jen čtení, účet služby ho musí umět přečíst)
# Po instalaci se aplikace ukončí a Restart=always ji spustí znovu s novým kódem.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
