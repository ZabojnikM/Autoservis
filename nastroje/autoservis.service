# Šablona služby systemd pro Autoservis na Linuxu.
# Doplň User a cestu (WorkingDirectory, ExecStart), pak:
#   sudo cp autoservis.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now autoservis
[Unit]
Description=Autoservis (FastAPI)
After=network.target

[Service]
User=UZIVATEL
WorkingDirectory=/CESTA/K/AUTOSERVIS
ExecStart=/CESTA/K/AUTOSERVIS/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
EnvironmentFile=-/CESTA/K/AUTOSERVIS/.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
